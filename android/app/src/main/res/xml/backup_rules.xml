<?xml version="1.0" encoding="utf-8"?>
<!--
  What crosses to a new phone on API 30 and below (ADR-0011, amended by
  ADR-0012).

  No <include> means "everything eligible", which is what we want: the whole
  record — the Room database and the settings around it — should arrive on the
  phone the parent moves to. Only the values that describe *this handset* are
  held back, because a restore can leave two phones running at once and they
  must not both answer to the same name.
-->
<full-backup-content>
    <!-- This install's sync identity: see DeviceIdentity. -->
    <exclude domain="sharedpref" path="device.xml" />
</full-backup-content>
