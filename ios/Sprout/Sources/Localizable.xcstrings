    "sync_histories_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Handy hat für sich aufgezeichnet, und Sprout kann nicht erkennen, welche Einträge denselben Moment meinen. Alles behalten — doppelt Notiertes erscheint dann doppelt — oder erst ab jetzt teilen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each phone has been tracking on its own, and Sprout cannot tell which entries are the same moment. Keep everything — anything logged twice will appear twice — or share only from now on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada teléfono ha registrado por su cuenta, y Sprout no puede saber qué entradas son el mismo momento. ¿Conservarlo todo —lo anotado dos veces aparecerá duplicado— o compartir solo a partir de ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque téléphone a suivi le bébé de son côté, et Sprout ne peut pas deviner quelles saisies correspondent au même moment. Tout garder — ce qui a été noté deux fois apparaîtra en double — ou ne partager qu'à partir de maintenant ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni telefono ha registrato per conto proprio, e Sprout non può sapere quali voci sono lo stesso momento. Tenere tutto — ciò che è stato annotato due volte comparirà due volte — oppure condividere solo da adesso in poi?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy telefon zapisywał osobno, a Sprout nie rozpozna, które wpisy dotyczą tej samej chwili. Zachować wszystko — to, co zapisano dwa razy, pojawi się podwójnie — czy udostępniać dopiero od teraz?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada telemóvel registou por sua conta, e o Sprout não consegue saber que registos são o mesmo momento. Manter tudo — o que foi anotado duas vezes aparecerá duas vezes — ou partilhar só a partir de agora?"
          }
        }
      }
    },
    "sync_histories_from_pairing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
