    "widget_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Mahlzeit — welches Baby, welche Art und vor wie langer Zeit — dazu die Brust, an der das letzte Stillen begonnen hat, oder die laufende Stillzeit mit Live-Timer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last feed — which baby, what kind, and how long ago — plus which breast the last breastfeed started on, or the breastfeeding session in progress with its live timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última toma — qué bebé, de qué tipo y hace cuánto — además del pecho con el que empezó la última lactancia, o la toma de pecho en curso con su cronómetro en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier repas — quel bébé, de quel type et il y a combien de temps — ainsi que le sein sur lequel la dernière tétée a commencé, ou la tétée en cours avec son minuteur en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultimo pasto — quale bambino, di che tipo e quanto tempo fa — più il seno da cui è iniziato l'ultimo allattamento, o la poppata in corso con il suo timer in tempo reale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni posiłek — które dziecko, jakiego rodzaju i jak dawno temu — oraz pierś, od której zaczęło się ostatnie karmienie piersią, albo trwające karmienie z licznikiem na żywo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A última refeição — qual bebé, de que tipo e há quanto tempo — mais a mama em que começou a última amamentação, ou a mamada em curso com o seu cronómetro ao vivo."
          }
        }
      }
    },
    "widget_error": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget konnte nicht gezeichnet werden. Öffne Sprout, oder entferne es und füge es neu hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't draw the widget. Open Sprout, or remove and add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo dibujar el widget. Abre Sprout, o quítalo y vuelve a añadirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'afficher le widget. Ouvrez Sprout, ou retirez-le et rajoutez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile disegnare il widget. Apri Sprout, oppure rimuovilo e aggiungilo di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się narysować widżetu. Otwórz Sprout albo usuń go i dodaj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desenhar o widget. Abra o Sprout, ou remova-o e adicione-o de novo."
          }
        }
      }
    },
