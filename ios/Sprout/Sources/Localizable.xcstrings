    "babies_empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Babys — füge dein Kleines hinzu, um mit dem Tracken zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No babies yet — add your little one to start tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay bebés. Añade a tu peque para empezar a registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun bébé pour le moment — ajoutez votre petit pour commencer le suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun bambino ancora — aggiungi il tuo piccolo per iniziare a tenere traccia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dzieci — dodaj swojego maluszka, aby zacząć śledzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há bebés — adicione o seu pequenino para começar a acompanhar."
          }
        }
      }
    },
