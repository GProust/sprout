    "report_privacy_note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird auf diesem Telefon geschrieben und geht nirgendwohin, bis du entscheidest, wohin. Sprout hat weiterhin keine Internet-Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is written on this phone and goes nowhere until you choose where to send it. Sprout still has no internet permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se escribe en este teléfono y no va a ninguna parte hasta que elijas adónde enviarlo. Sprout sigue sin permiso de internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est écrit sur ce téléphone et ne part nulle part tant que vous ne choisissez pas où l'envoyer. Sprout n'a toujours pas la permission Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene scritto su questo telefono e non va da nessuna parte finché non scegli tu dove mandarlo. Sprout continua a non avere il permesso di accesso a internet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik powstaje na tym telefonie i nigdzie nie trafia, dopóki sam nie wybierzesz, dokąd go wysłać. Sprout nadal nie ma uprawnienia do internetu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro é escrito neste telemóvel e não vai a lado nenhum até escolher para onde o enviar. O Sprout continua sem permissão de internet."
          }
        }
      }
    },
