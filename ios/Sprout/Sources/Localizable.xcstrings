    "sync_paired_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Euer Haushaltscode ist %1$@. Prüfe, ob die anderen Handys denselben zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your household code is %1$@. Check that the other phones show the same one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de vuestro hogar es %1$@. Comprueba que los demás teléfonos muestran el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de votre foyer est %1$@. Vérifiez que les autres téléphones affichent le même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice della vostra famiglia è %1$@. Controlla che gli altri telefoni mostrino lo stesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod waszego domu to %1$@. Sprawdź, czy pozostałe telefony pokazują ten sam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código do vosso agregado é %1$@. Confirme que os outros telemóveis mostram o mesmo."
          }
        }
      }
    },
    "sync_paired_body_named": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dem Haushalt von %1$@ beigetreten. Euer Code ist %2$@ — prüfe, ob die anderen Handys denselben zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined %1$@'s household. Your code is %2$@ — check that the other phones show the same one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te has unido al hogar de %1$@. Vuestro código es %2$@: comprueba que los demás teléfonos muestran el mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez rejoint le foyer de %1$@. Votre code est %2$@ — vérifiez que les autres téléphones affichent le même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei entrato nella famiglia di %1$@. Il vostro codice è %2$@: controlla che gli altri telefoni mostrino lo stesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączono do domu: %1$@. Wasz kod to %2$@ — sprawdź, czy pozostałe telefony pokazują ten sam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrou no agregado de %1$@. O vosso código é %2$@ — confirme que os outros telemóveis mostram o mesmo."
          }
        }
      }
    },
