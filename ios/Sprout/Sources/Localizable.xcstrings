    "sync_remove_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Handy zu entfernen ändert den Schlüssel des Haushalts, also braucht auch jedes andere Handy eine neue Einladung — auch eines, das gerade ausgeschaltet ist. Das entfernte Handy behält, was es schon hat; das lässt sich nicht zurücknehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a phone changes the household's key, so every other phone needs a new invitation too — including any that is switched off right now. The removed phone keeps what it already has; nothing can take that back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar un teléfono cambia la clave del hogar, así que todos los demás necesitarán también una invitación nueva, incluido cualquiera que esté apagado ahora mismo. El teléfono quitado conserva lo que ya tiene; eso no se le puede retirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer un téléphone change la clé du foyer : tous les autres téléphones auront eux aussi besoin d'une nouvelle invitation — y compris ceux qui sont éteints en ce moment. Le téléphone retiré garde ce qu'il a déjà ; rien ne peut le lui reprendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere un telefono cambia la chiave della famiglia, quindi anche tutti gli altri telefoni avranno bisogno di un nuovo invito — compreso uno che in questo momento è spento. Il telefono rimosso tiene ciò che ha già; questo non si può riprendere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie telefonu zmienia klucz domu, więc każdy pozostały telefon również będzie potrzebował nowego zaproszenia — także taki, który jest teraz wyłączony. Usunięty telefon zachowuje to, co już ma; tego nie da się cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover um telemóvel muda a chave do agregado, por isso todos os outros vão precisar de um novo convite — incluindo qualquer um que esteja desligado neste momento. O telemóvel removido fica com o que já tem; isso não se pode retirar."
          }
        }
      }
    },
    "sync_remove_title": {
      "localizations": {
