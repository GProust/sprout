    "settings_sync_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Aufzeichnungen des Babys mit den anderen, die sich kümmern — ohne Konto, ohne Cloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
