    "report_protect_compat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit AES-256 verschlüsselt. Es öffnet sich mit 7-Zip, WinZip, Keka oder den meisten Android-Dateimanagern — das in Windows und macOS eingebaute Entpacken kann es nicht öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted with AES-256. It opens with 7-Zip, WinZip, Keka or most Android file managers — the unzip built into Windows and macOS cannot open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado con AES-256. Se abre con 7-Zip, WinZip, Keka o la mayoría de gestores de archivos de Android; el descompresor incluido en Windows y macOS no puede abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffré en AES-256. Il s'ouvre avec 7-Zip, WinZip, Keka ou la plupart des gestionnaires de fichiers Android — la décompression intégrée à Windows et macOS ne sait pas l'ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrato con AES-256. Si apre con 7-Zip, WinZip, Keka o quasi tutti i gestori di file Android — l'estrazione integrata in Windows e macOS non riesce ad aprirlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowane algorytmem AES-256. Otworzy je 7-Zip, WinZip, Keka albo większość menedżerów plików na Androidzie — rozpakowywanie wbudowane w Windowsa i macOS-a sobie z tym nie poradzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrado com AES-256. Abre com o 7-Zip, o WinZip, o Keka ou a maioria dos gestores de ficheiros Android — a descompactação incluída no Windows e no macOS não o consegue abrir."
          }
        }
      }
    },
    "report_protect_hint": {
      "localizations": {
