    "onboarding_checkin_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte auf deinem Dashboard für dein Befinden — nie eine Benachrichtigung. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card on your dashboard for how you're doing — never a notification. You can change this anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta en tu panel para ver cómo estás; nunca una notificación. Puedes cambiarlo cuando quieras en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte sur votre tableau de bord pour prendre de vos nouvelles — jamais une notification. Vous pourrez changer d'avis dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda sulla tua dashboard per come stai: mai una notifica. Puoi cambiare idea quando vuoi nelle impostazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta na pulpicie, by zapisać, jak się czujesz — nigdy powiadomienie. Możesz to zmienić w każdej chwili w ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão no seu painel para registar como está — nunca uma notificação. Pode mudar de ideias a qualquer momento nas definições."
          }
        }
      }
    },
