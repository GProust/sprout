          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux téléphones ont déjà des saisies"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i telefoni hanno già delle voci"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba telefony mają już wpisy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos os telemóveis já têm registos"
          }
        }
      }
    },
    "sync_intro_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade den anderen Elternteil ein — oder eine Großmutter, die das Baby regelmäßig hat. Sobald ein Handy dazugehört, kann jeder seine Einträge hinüberschicken und Sprout führt sie zusammen: ohne Konto, ohne Server und ohne dass irgendetwas woanders liegt als auf euren eigenen Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite the other parent — or a grandparent who has the baby regularly. Once a phone has joined, everyone can send their entries across and Sprout merges them: no account, no server, and nothing kept anywhere but your own phones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a la otra madre o al otro padre, o a una abuela que se queda con el bebé a menudo. Cuando un teléfono se une, cada persona puede enviar sus entradas y Sprout las combina: sin cuenta, sin servidor y sin que nada se guarde fuera de vuestros propios teléfonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez l'autre parent — ou un grand-parent qui garde le bébé régulièrement. Une fois un téléphone entré dans le foyer, chacun peut envoyer ses saisies et Sprout les fusionne : sans compte, sans serveur, et rien n'est conservé ailleurs que sur vos propres téléphones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita l'altro genitore, o un nonno che tiene il bambino spesso. Quando un telefono entra, ciascuno può inviare le proprie voci e Sprout le unisce: nessun account, nessun server e niente conservato al di fuori dei vostri telefoni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproś drugiego rodzica albo babcię, która regularnie zajmuje się dzieckiem. Gdy telefon dołączy, każdy może wysłać swoje wpisy, a Sprout je scali: bez konta, bez serwera i bez przechowywania czegokolwiek poza waszymi własnymi telefonami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide a outra mãe ou o outro pai, ou uma avó que fica com o bebé com regularidade. Assim que um telemóvel entra, cada um pode enviar os seus registos e o Sprout junta-os: sem conta, sem servidor e sem nada guardado fora dos vossos próprios telemóveis."
          }
        }
      }
    },
    "sync_intro_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufzeichnung, alle Handys im Haushalt"
