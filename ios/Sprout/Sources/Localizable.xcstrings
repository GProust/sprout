    "onboarding_welcome_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Ort, um die ersten Wochen deines Kleinen festzuhalten — und auch, um auf dich selbst zu achten.\n\nLass uns alles einrichten. Es dauert nur einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle space to track your little one's first weeks — and to look after you, too.\n\nLet's set things up. It'll only take a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio tranquilo para registrar las primeras semanas de tu peque, y para cuidarte a ti también.\n\nVamos a configurarlo todo. Solo te llevará un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace tout en douceur pour suivre les premières semaines de votre tout-petit — et pour prendre soin de vous aussi.\n\nConfigurons l'application ensemble. Ce ne sera qu'une affaire de quelques instants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno spazio gentile per seguire le prime settimane del tuo piccolo — e per prenderti cura anche di te.\n\nIniziamo a configurare. Ci vorrà solo un attimo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojne miejsce, by śledzić pierwsze tygodnie Twojego maluszka — i zadbać także o siebie.\n\nUstawmy wszystko razem. Zajmie to tylko chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço tranquilo para acompanhar as primeiras semanas do seu pequenino — e para cuidar também de si.\n\nVamos preparar tudo. Demora só um momento."
          }
        }
      }
    },
