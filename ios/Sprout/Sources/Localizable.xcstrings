    "report_note_averages": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mittelwerte gehen über die %1$lld vollständigen Tage des Zeitraums; der %2$@ zählt in den Summen mit und bleibt aus den Mittelwerten heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Averages are over the %1$lld completed days in the period; %2$@ is counted in the totals and left out of the averages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las medias son sobre los %1$lld días completos del periodo; el %2$@ cuenta en los totales y queda fuera de las medias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les moyennes portent sur les %1$lld jours complets de la période ; le %2$@ est compté dans les totaux et exclu des moyennes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le medie riguardano i %1$lld giorni completi del periodo; il %2$@ è contato nei totali ed escluso dalle medie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnie liczone są z %1$lld pełnych dni okresu; dzień %2$@ wlicza się do sum, ale nie do średnich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As médias abrangem os %1$lld dias completos do período; o dia %2$@ conta nos totais e fica de fora das médias."
          }
        }
      }
    },
    "report_note_bottles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flaschenmenge umfasst die %1$lld von %2$lld Flaschen, bei denen eine Menge notiert wurde."
          }
        },
        "en": {
