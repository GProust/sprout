    "sync_channel_warning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einladung enthält den Schlüssel zu euren Aufzeichnungen, und wer ihn hat, kann alles Geteilte lesen und ergänzen. Schick sie über etwas Privates — einen Messenger, Quick Share, Bluetooth — und nicht über etwas Öffentliches."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invitation carries the key to your record, and anyone who has it can read and add to everything shared. Send it through something private — a messaging app, Quick Share, Bluetooth — and not anywhere public."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invitación lleva la clave de vuestro registro, y quien la tenga podrá leer y añadir todo lo compartido. Envíala por un canal privado —una app de mensajería, Quick Share, Bluetooth— y nunca por un sitio público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invitation contient la clé de votre suivi, et quiconque l'a peut lire et compléter tout ce qui est partagé. Envoyez-la par un canal privé — messagerie, Quick Share, Bluetooth — et jamais sur un espace public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invito contiene la chiave del vostro diario, e chi ce l'ha può leggere e aggiungere tutto ciò che è condiviso. Mandalo con qualcosa di privato — un'app di messaggistica, Quick Share, Bluetooth — e mai in un luogo pubblico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszenie zawiera klucz do waszych zapisów, a każdy, kto go ma, może czytać i dopisywać wszystko, co jest współdzielone. Wyślij je czymś prywatnym — komunikatorem, Quick Share, Bluetoothem — a nigdy w miejscu publicznym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O convite leva a chave do vosso registo, e quem a tiver pode ler e acrescentar tudo o que é partilhado. Envie-o por algo privado — uma app de mensagens, Quick Share, Bluetooth — e nunca por um espaço público."
          }
        }
      }
    },
    "sync_code_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Handys im Haushalt zeigen dieselben sechs Zeichen. Lest sie euch einmal vor: Ein Handy, das etwas anderes zeigt, gehört nicht zu eurem Haushalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every phone in the household shows these same six characters. Read them to each other once: a phone showing something else is not in your household."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los teléfonos del hogar muestran esos mismos seis caracteres. Leedlos en voz alta una vez: un teléfono que muestre otra cosa no está en vuestro hogar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les téléphones du foyer affichent ces six mêmes caractères. Lisez-les-vous une fois à voix haute : un téléphone qui en affiche d'autres n'est pas dans votre foyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i telefoni della famiglia mostrano gli stessi sei caratteri. Leggeteveli una volta ad alta voce: un telefono che ne mostra altri non fa parte della vostra famiglia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie telefony w domu pokazują te same sześć znaków. Przeczytajcie je sobie raz na głos: telefon, który pokazuje coś innego, nie należy do waszego domu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os telemóveis do agregado mostram os mesmos seis caracteres. Leiam-nos uns aos outros uma vez: um telemóvel que mostre outra coisa não pertence ao vosso agregado."
          }
        }
      }
    },
    "sync_code_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Euer Haushaltscode"
          }
        },
        "en": {
