          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el registro del bebé con las demás personas que lo cuidan: sin cuenta y sin nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez le suivi du bébé avec les autres personnes qui s'en occupent — sans compte, sans cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il diario del bambino con le altre persone che se ne occupano: nessun account, nessun cloud."
