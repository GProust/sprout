    "sync_histories_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Handys haben schon Einträge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both phones have entries already"
          }
        },
        "es": {
          "stringUnit": {
