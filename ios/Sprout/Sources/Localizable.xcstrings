    "babies_not_tracking_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt erhalten. Stelle wieder her, um erneut zu tracken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their history is kept. Restore to track again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva su historial. Restáuralo para volver a hacer seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur historique est conservé. Restaurez pour reprendre le suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La loro cronologia viene conservata. Ripristina per monitorare di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
