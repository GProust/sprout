    "report_treatment_note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Behandlungen so, wie sie in der App geplant sind, über dieselben Tage wie der übrige Bericht. Sprout erfasst nicht, ob eine einzelne Gabe wirklich erfolgt ist — das hier ist also der Plan und keine Dokumentation der Gaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Courses as they were scheduled in the app, on the same dates as the rest of this report. Sprout does not record whether an individual dose was given, so this is the plan rather than an administration record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tratamientos tal como están programados en la aplicación, sobre las mismas fechas que el resto del informe. Sprout no registra si una toma concreta se dio, así que esto es el plan y no un registro de administración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traitements tels qu'ils sont programmés dans l'application, aux mêmes dates que le reste de ce relevé. Sprout n'enregistre pas si une prise a réellement eu lieu : c'est donc le plan prévu, et non un relevé d'administration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terapie come sono programmate nell'app, sulle stesse date del resto del resoconto. Sprout non registra se una singola dose sia stata davvero data: questo è quindi il piano, non un registro delle somministrazioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuracje tak, jak zaplanowano je w aplikacji, na tych samych datach co reszta raportu. Sprout nie zapisuje, czy pojedyncza dawka została podana — to jest więc plan, a nie zapis podań."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tratamentos tal como estão programados na aplicação, nas mesmas datas do resto do relatório. O Sprout não regista se uma toma foi mesmo dada, por isso isto é o plano e não um registo de administração."
          }
        }
      }
    },
    "report_week_by_week": {
      "localizations": {
