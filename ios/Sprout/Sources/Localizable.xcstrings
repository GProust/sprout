    "report_password_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort in der Praxis oder am Telefon weiter — nicht in derselben Nachricht wie die Datei. Sprout behält keine Kopie davon und kann es nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the password to the doctor in person or over the phone — not in the same message as the file. Sprout keeps no copy of it and cannot recover it for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale la contraseña al médico en persona o por teléfono, no en el mismo mensaje que el archivo. Sprout no guarda ninguna copia y no puede recuperarla por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez le mot de passe au médecin de vive voix ou par téléphone — pas dans le même message que le fichier. Sprout n'en garde aucune copie et ne peut pas le retrouver pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai la password al medico di persona o al telefono, non nello stesso messaggio del file. Sprout non ne conserva copia e non può recuperarla per te."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaż hasło lekarzowi osobiście albo przez telefon — nie w tej samej wiadomości co plik. Sprout nie przechowuje jego kopii i nie odzyska go za Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a palavra-passe ao médico pessoalmente ou por telefone — não na mesma mensagem que o ficheiro. O Sprout não guarda cópia dela e não a consegue recuperar por si."
          }
        }
      }
    },
    "report_password_short": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens %1$lld Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %1$lld characters."
          }
        },
        "es": {
