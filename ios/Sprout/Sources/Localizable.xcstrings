    "report_weekly_note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeitraum über 92 Tage wird nach Wochen statt nach Tagen aufgeführt; jede Zeile summiert die Tage, die sie abdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A period longer than 92 days is listed by week rather than by day; each row totals the days it covers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un periodo de más de 92 días se lista por semanas en lugar de por días; cada fila suma los días que abarca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une période de plus de 92 jours est listée par semaine plutôt que par jour ; chaque ligne totalise les jours qu'elle couvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un periodo più lungo di 92 giorni è elencato per settimane invece che per giorni; ogni riga somma i giorni che copre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres dłuższy niż 92 dni jest wypisany tygodniami zamiast dniami; każdy wiersz sumuje dni, które obejmuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um período com mais de 92 dias é listado por semanas em vez de por dias; cada linha soma os dias que abrange."
          }
        }
      }
    },
