    "sync_merged_nothing_new": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Neues — beide Handys waren schon einig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new — both phones already agreed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo: los dos teléfonos ya coincidían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau — les deux téléphones étaient déjà d'accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di nuovo: i due telefoni erano già d'accordo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nowego — oba telefony już się zgadzały."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo — os dois telemóveis já concordavam."
          }
        }
      }
    },
