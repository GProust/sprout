    "settings_support_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ist kostenlos, quelloffen und bleibt es auch — alle Funktionen sind da, ob du etwas gibst oder nicht. Wenn dir die App durch die ersten Wochen geholfen hat und du zur Entwicklung beitragen möchtest: Diese Links öffnen sich in deinem Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout is free, open-source and always will be — every feature is here whether or not you ever give a penny. If it has helped you through the early weeks and you'd like to chip in towards its development, these open in your browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout es gratuita, de código abierto y siempre lo será: todas las funciones están aquí, dones o no. Si la app te ha acompañado en las primeras semanas y quieres contribuir a su desarrollo, estos enlaces se abren en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout est gratuite, open source, et le restera — toutes les fonctionnalités sont là que vous donniez ou non. Si l'application vous a aidé·e pendant les premières semaines et que vous souhaitez contribuer à son développement, ces liens s'ouvrent dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout è gratuita, open source e lo resterà — tutte le funzioni ci sono, che tu doni o no. Se l'app ti è stata d'aiuto nelle prime settimane e vuoi contribuire al suo sviluppo, questi link si aprono nel browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout jest darmowa, otwartoźródłowa i taka pozostanie — wszystkie funkcje są dostępne niezależnie od tego, czy wesprzesz projekt. Jeśli aplikacja pomogła Ci w pierwszych tygodniach i chcesz dołożyć się do jej rozwoju, te odnośniki otworzą się w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout é gratuito, de código aberto e sempre será — todas as funcionalidades estão aqui, contribua ou não. Se a app o ajudou nas primeiras semanas e quiser contribuir para o seu desenvolvimento, estas ligações abrem no seu navegador."
          }
        }
      }
    },
