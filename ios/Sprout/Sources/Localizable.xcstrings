    "sync_nearby_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen von Sprout per Bluetooth nach den Handys des Haushalts in der Nähe suchen und mit ihnen austauschen. Gesucht wird nur, während die App offen ist, und jeweils ein paar Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open Sprout, look for the household's phones nearby over Bluetooth and exchange with them. It only looks while the app is open, for a few seconds at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir Sprout, buscar por Bluetooth los teléfonos del hogar que estén cerca e intercambiar con ellos. Solo busca mientras la aplicación está abierta, unos segundos cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'ouverture de Sprout, chercher les téléphones du foyer à proximité par Bluetooth et échanger avec eux. La recherche n'a lieu que pendant que l'application est ouverte, quelques secondes à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'apertura di Sprout, cerca via Bluetooth i telefoni della famiglia lì vicino e scambia con loro. Cerca solo mentre l'app è aperta, per pochi secondi alla volta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po otwarciu Sprout szukaj przez Bluetooth telefonów domowników w pobliżu i wymieniaj się z nimi. Szuka tylko wtedy, gdy aplikacja jest otwarta, po kilka sekund."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir o Sprout, procurar por Bluetooth os telemóveis do agregado que estejam perto e trocar com eles. Só procura enquanto a aplicação está aberta, uns segundos de cada vez."
          }
        }
      }
    },
    "sync_nearby_error_bluetooth_off": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist aus. Schalte es ein und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off. Turn it on and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth está apagado. Actívalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth est désactivé. Activez-le et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bluetooth è spento. Attivalo e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth jest wyłączony. Włącz go i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth está desligado. Ligue-o e tente de novo."
          }
        }
      }
    },
    "sync_nearby_error_first_merge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Austausch ist eine Frage zu beantworten. Öffne einmal eine Datei vom anderen Handy, danach läuft es von allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first exchange has a question to answer. Open a file sent from the other phone once, and after that this works on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer intercambio tiene una pregunta que responder. Abre una vez un archivo enviado desde el otro teléfono y después esto funcionará solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier échange comporte une question à trancher. Ouvrez une fois un fichier envoyé par l'autre téléphone, ensuite cela se fera tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo scambio ha una domanda a cui rispondere. Apri una volta un file inviato dall'altro telefono, poi funzionerà da solo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza wymiana wymaga odpowiedzi na jedno pytanie. Otwórz raz plik przysłany z drugiego telefonu, a potem będzie działać samo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira troca tem uma pergunta a responder. Abra uma vez um ficheiro enviado do outro telemóvel e depois passa a funcionar sozinho."
          }
        }
      }
    },
    "sync_nearby_error_no_bluetooth": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Handy hat kein Bluetooth und kann daher nur Dateien austauschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no Bluetooth, so it can only exchange files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono no tiene Bluetooth, así que solo puede intercambiar archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n'a pas de Bluetooth : il ne peut qu'échanger des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non ha il Bluetooth, quindi può solo scambiare file."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie ma Bluetootha, więc może tylko wymieniać pliki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telemóvel não tem Bluetooth, por isso só pode trocar ficheiros."
          }
        }
      }
    },
    "sync_nearby_error_no_permission": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout braucht die Berechtigung, Geräte in der Nähe zu finden. Sie dient nur dazu, die Handys des Haushalts zu erkennen, nie deinem Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout needs permission to find nearby devices. It is only used to spot the household's phones, never your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout necesita permiso para detectar dispositivos cercanos. Solo se usa para reconocer los teléfonos del hogar, nunca tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout a besoin de l'autorisation de détecter les appareils à proximité. Elle sert uniquement à repérer les téléphones du foyer, jamais à connaître votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout ha bisogno del permesso di rilevare i dispositivi vicini. Serve solo a riconoscere i telefoni della famiglia, mai la tua posizione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout potrzebuje zgody na wykrywanie urządzeń w pobliżu. Służy wyłącznie do rozpoznania telefonów domowników, nigdy do ustalania twojej lokalizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sprout precisa de autorização para detetar dispositivos por perto. Serve apenas para reconhecer os telemóveis do agregado, nunca a sua localização."
          }
        }
      }
    },
    "sync_nearby_error_radio": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth hat die Suche verweigert. Bluetooth aus- und wieder einzuschalten hilft meist; andernfalls funktioniert das Senden einer Datei immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth refused to start the search. Turning Bluetooth off and on again usually clears it; otherwise, sending a file always works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bluetooth se ha negado a iniciar la búsqueda. Apagarlo y volver a encenderlo suele bastar; si no, enviar un archivo siempre funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth a refusé de lancer la recherche. L'éteindre puis le rallumer suffit en général ; sinon, l'envoi d'un fichier fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bluetooth ha rifiutato di avviare la ricerca. Spegnerlo e riaccenderlo di solito basta; altrimenti, inviare un file funziona sempre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth odmówił rozpoczęcia wyszukiwania. Zwykle wystarczy go wyłączyć i włączyć ponownie; jeśli nie, wysłanie pliku zawsze działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth recusou iniciar a procura. Desligá-lo e voltar a ligá-lo costuma resolver; caso contrário, enviar um ficheiro funciona sempre."
          }
        }
      }
    },
    "sync_nearby_error_too_old": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Android-Version dieses Handys ist dafür zu alt; es tauscht stattdessen Dateien aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's version of Android is too old for this, so it exchanges files instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de Android de este teléfono es demasiado antigua para esto; intercambia archivos en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version d'Android de ce téléphone est trop ancienne pour cela ; il échange des fichiers à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione di Android di questo telefono è troppo vecchia per questo; scambia file invece."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja Androida na tym telefonie jest na to za stara; zamiast tego wymienia pliki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de Android deste telemóvel é demasiado antiga para isto; troca ficheiros em vez disso."
          }
        }
      }
    },
    "sync_nearby_nobody_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Handy aus eurem Haushalt hat geantwortet. Es muss ein paar Meter entfernt sein und Sprout offen haben. Eine Datei zu schicken geht von überall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone from your household answered. They have to be within a few metres with Sprout open. Sending a file works from anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún teléfono de vuestro hogar respondió. Tiene que estar a unos metros y con Sprout abierto. Enviar un archivo funciona desde cualquier sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléphone de votre foyer n'a répondu. Il faut qu'il soit à quelques mètres avec Sprout ouvert. L'envoi d'un fichier fonctionne de n'importe où."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun telefono della vostra famiglia ha risposto. Deve essere a pochi metri e con Sprout aperto. Inviare un file funziona da qualunque posto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden telefon z waszego domu nie odpowiedział. Musi być w odległości kilku metrów z otwartym Sprout. Wysłanie pliku działa z dowolnego miejsca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum telemóvel do vosso agregado respondeu. Tem de estar a poucos metros e com o Sprout aberto. Enviar um ficheiro funciona a partir de qualquer lado."
          }
        }
      }
    },
