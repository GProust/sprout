    "sync_stash_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abpump-Protokoll und der Milchvorrat — mit dem ganzen Haushalt geteilt oder mit niemandem. Alles rund ums Baby wird ohnehin geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pumping log and the milk stash, shared with the whole household or with nobody. Everything about the baby is shared either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de extracciones y la reserva de leche, compartidos con todo el hogar o con nadie. Todo lo que tiene que ver con el bebé se comparte igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique de tirage et le stock de lait, partagés avec tout le foyer ou avec personne. Tout ce qui concerne le bébé est partagé dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo registro dei tiraggi e la scorta di latte, condivisi con tutta la famiglia o con nessuno. Tutto ciò che riguarda il bambino viene condiviso comunque."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zapis odciągania i zapas mleka — udostępniane całemu domowi albo nikomu. Wszystko, co dotyczy dziecka, i tak jest współdzielone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu registo de extrações e a reserva de leite, partilhados com todo o agregado ou com ninguém. Tudo o que diz respeito ao bebé é partilhado de qualquer forma."
          }
        }
      }
    },
    "sync_stash_off_note": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten stoppt künftige Sendungen. Was du bereits gesendet hast, bleibt auf dem anderen Handy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this off stops future sends. What you have already sent stays on the other phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivarlo detiene los envíos futuros. Lo que ya enviaste se queda en el otro teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver arrête les envois à venir. Ce que vous avez déjà envoyé reste sur l'autre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivarlo ferma gli invii futuri. Quello che hai già inviato resta sull'altro telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączenie zatrzymuje przyszłe wysyłki. To, co już wysłano, zostaje na drugim telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar interrompe os envios futuros. O que já enviou permanece no outro telemóvel."
          }
        }
      }
    },
    "sync_stash_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgepumpte Milch teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share expressed milk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir la leche extraída"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager le lait tiré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il latte tirato"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj odciągnięte mleko"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhar o leite extraído"
          }
        }
