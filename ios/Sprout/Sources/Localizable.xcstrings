    "settings_checkin_section_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Fragen dein Check-in stellt. Eine abgewählte Frage wird nicht mehr gestellt; du kannst sie hier jederzeit wieder aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which questions your check-in asks. Opting out of a question skips it every day; you can bring it back here anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué preguntas hace tu chequeo. Una pregunta desactivada deja de hacerse; puedes reactivarla aquí cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les questions posées lors de votre bilan. Une question désactivée n'est plus posée ; vous pouvez la réactiver ici à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali domande fa il tuo check-in. Una domanda disattivata non viene più posta; puoi riattivarla qui in qualsiasi momento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, o co pyta Twój codzienny wpis. Wyłączone pytanie nie będzie już zadawane; możesz je tu w każdej chwili włączyć ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha as perguntas da sua verificação. Uma pergunta desativada deixa de ser feita; pode reativá-la aqui a qualquer momento."
          }
        }
      }
    },
    "settings_checkin_track_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte auf deinem Dashboard für dein Befinden — Sprout unterbricht dich dafür nie. Schaltest du sie aus, verschwindet der Check-in; deine bisherigen Einträge bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A card on your dashboard for how you're doing — Sprout never interrupts you for it. Turn it off and the check-in disappears; your past entries are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta en tu panel para ver cómo estás; Sprout nunca te interrumpe por ello. Si lo desactivas, el chequeo desaparece; tus entradas anteriores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte sur votre tableau de bord pour prendre de vos nouvelles — Sprout ne vous interrompt jamais pour cela. Désactivez-le et le bilan disparaît ; vos entrées passées sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda sulla tua dashboard per come stai: Sprout non ti interrompe mai per questo. Se lo disattivi, il check-in sparisce; le voci già registrate restano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta na pulpicie, by zapisać, jak się czujesz — Sprout nigdy Ci dla niej nie przerywa. Po wyłączeniu wpis znika; dotychczasowe zapisy pozostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cartão no seu painel para registar como está — o Sprout nunca o interrompe por causa disso. Se desativar, a verificação desaparece; os registos anteriores são mantidos."
          }
        }
      }
    },
