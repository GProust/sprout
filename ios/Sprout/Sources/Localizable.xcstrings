    "report_intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bericht über das, was du für %1$@ notiert hast, zum Mitgeben in die Praxis. Beide Dateien entstehen auf diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A record of what you have logged for %1$@, to hand to a doctor. Both files are made on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro de lo que has anotado sobre %1$@, para llevar al médico. Los dos archivos se crean en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relevé de ce que vous avez noté pour %1$@, à remettre au médecin. Les deux fichiers sont créés sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resoconto di ciò che hai annotato per %1$@, da portare al medico. Entrambi i file nascono su questo telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis tego, co odnotowano dla: %1$@, do zabrania do lekarza. Oba pliki powstają na tym telefonie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um registo do que anotou para %1$@, para levar ao médico. Ambos os ficheiros são criados neste telemóvel."
          }
        }
      }
    },
