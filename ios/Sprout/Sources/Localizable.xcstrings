    "stats_who_outside": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb des WHO-Bereichs (P3–P97), etwa %1$@. Beim nächsten Termin ansprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the WHO band (P3–P97), around %1$@. Worth a word at the next appointment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de la banda de la OMS (P3–P97), en torno a %1$@. Conviene comentarlo en la próxima cita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors de la bande OMS (P3–P97), autour de %1$@. À signaler au prochain rendez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dalla fascia OMS (P3–P97), intorno a %1$@. Da segnalare alla prossima visita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poza pasmem WHO (P3–P97), około %1$@. Warto wspomnieć na najbliższej wizycie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora da banda da OMS (P3–P97), à volta de %1$@. Vale a pena falar na próxima consulta."
          }
