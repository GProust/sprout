    "growth_spurt_notif_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachstumsschübe sind %1$@ häufig. Mehr Mahlzeiten und Quengeln sind normal — meist ist es nach ein paar Tagen vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Growth spurts are common %1$@. Extra feeds and fussiness are normal — it usually passes in a few days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estirones de crecimiento son habituales %1$@. Más tomas e irritabilidad son normales; suele pasar en unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pics de croissance sont fréquents %1$@. Plus de repas et de grognons — c'est normal, et ça passe en général en quelques jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli scatti di crescita sono frequenti %1$@. Più pasti e irritabilità sono normali: di solito passa in pochi giorni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoki rozwojowe są częste %1$@. Więcej karmień i marudzenia to nic niepokojącego — zwykle mija po kilku dniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os saltos de crescimento são comuns %1$@. Mais refeições e irritação são normais — costuma passar em poucos dias."
          }
        }
      }
    },
    "growth_spurt_notif_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht beginnt gerade ein Wachstumsschub"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A growth spurt may be starting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que empiece un estirón de crecimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pic de croissance commence peut-être"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe iniziare uno scatto di crescita"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Być może zaczyna się skok rozwojowy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode estar a começar um salto de crescimento"
          }
        }
      }
    },
    "growth_spurt_notif_title_baby": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %1$@ könnte ein Wachstumsschub beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ may be starting a growth spurt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que %1$@ esté empezando un estirón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ commence peut-être un pic de croissance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forse %1$@ sta iniziando uno scatto di crescita"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ może właśnie zaczynać skok rozwojowy"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pode estar a começar um salto de crescimento"
          }
        }
      }
    },
    "growth_spurt_now_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Babys machen %1$@ einen Wachstumsschub durch. Mehr Hunger, häufigeres Aufwachen und Quengeln sind normal — meist ist es nach ein paar Tagen vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Babies often go through a growth spurt %1$@. Extra hunger, more waking and fussiness are normal — it usually passes in a few days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos bebés dan un estirón de crecimiento %1$@. Más hambre, más despertares e irritabilidad son normales; suele pasar en unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bébés traversent souvent un pic de croissance %1$@. Plus de faim, plus de réveils et de grognons — c'est normal, et ça passe en général en quelques jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molti bimbi attraversano uno scatto di crescita %1$@. Più fame, più risvegli e irritabilità sono normali: di solito passa in pochi giorni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele niemowląt przechodzi skok rozwojowy %1$@. Większy głód, częstsze pobudki i marudzenie są normalne — zwykle mija po kilku dniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos bebés passam por um salto de crescimento %1$@. Mais fome, mais despertares e irritação são normais — costuma passar em poucos dias."
          }
        }
      }
    },
