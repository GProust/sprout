    "sync_devices_empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch hat kein anderes Handy etwas geschickt. Jedes erscheint hier, sobald es das erste Mal etwas sendet."
          }
        },
        "en": {
          "stringUnit": {
