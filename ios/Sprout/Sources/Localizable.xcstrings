    "stats_empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Zeitraum ist noch nichts eingetragen. Mahlzeiten, Schlaf und Wickeln werden hier Tag für Tag zusammengezählt."
