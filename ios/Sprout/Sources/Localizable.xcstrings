    "baby_delete_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt %1$@ dauerhaft sowie alle Mahlzeiten-, Schlaf-, Windel- und Wachstumseinträge für sie. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes %1$@ and every feeding, sleep, diaper and growth entry for them. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente a %1$@ y todas sus entradas de tomas, sueño, pañal y crecimiento. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement %1$@ ainsi que tous ses repas, sommeils, couches et mesures de croissance. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente %1$@ e ogni voce di pasto, sonno, pannolino e crescita relativa. L'operazione non può essere annullata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usuwa %1$@ oraz każdy wpis karmienia, snu, pieluchy i wzrostu dla tego dziecka. Tego nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente %1$@ e todos os registos de alimentação, sono, fralda e crescimento. Não pode ser anulado."
          }
        }
      }
    },
