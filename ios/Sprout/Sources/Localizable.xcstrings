    "report_provenance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl hier ist eine Anzahl oder eine Summe von Einträgen, die die Familie selbst eingegeben hat. Nichts ist geschätzt, nichts ist abgeleitet, und nichts in diesem Dokument ist eine Beurteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every figure here is a count or a total of entries the family typed in. Nothing is estimated, nothing is inferred, and nothing in this document is an assessment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cifra es un recuento o un total de entradas escritas por la familia. Nada está estimado, nada está deducido, y nada en este documento es una valoración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chiffre est un décompte ou un total d'entrées saisies par la famille. Rien n'est estimé, rien n'est déduit, et rien dans ce document n'est une évaluation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cifra è un conteggio o un totale di voci inserite dalla famiglia. Nulla è stimato, nulla è dedotto, e nulla in questo documento è una valutazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda liczba tutaj to zliczenie albo suma wpisów, które rodzina wprowadziła sama. Nic nie jest szacowane, nic nie jest wywnioskowane i nic w tym dokumencie nie jest oceną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada número aqui é uma contagem ou um total de entradas que a família escreveu. Nada é estimado, nada é inferido, e nada neste documento é uma avaliação."
          }
        }
      }
    },
    "report_reference_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählst du eine, steht dort ein einzelnes Perzentil statt einer Spanne. Sprout fragt weiterhin nicht nach dem Geschlecht des Babys, speichert es nicht und vergisst diese Wahl, sobald du den Bildschirm verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picking one prints a single centile instead of a span. Sprout still never asks a baby's sex, never stores it, and forgets this choice when you leave the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir una imprime un percentil único en lugar de un intervalo. Sprout sigue sin preguntar el sexo del bebé, no lo guarda y olvida esta elección al salir de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En choisir une affiche un percentile unique au lieu d'un intervalle. Sprout ne demande toujours pas le sexe du bébé, ne l'enregistre pas, et oublie ce choix dès que vous quittez l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglierne uno stampa un singolo percentile invece di un intervallo. Sprout continua a non chiedere il sesso del bambino, non lo salva e dimentica questa scelta appena esci dalla schermata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybranie jednej drukuje pojedynczy centyl zamiast zakresu. Sprout nadal nie pyta o płeć dziecka, nie zapisuje jej i zapomina ten wybór po wyjściu z ekranu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher uma imprime um percentil único em vez de um intervalo. O Sprout continua a não perguntar o sexo do bebé, não o guarda e esquece esta escolha quando sai do ecrã."
          }
        }
      }
    },
