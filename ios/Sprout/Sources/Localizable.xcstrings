    "sync_rotated_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Euer neuer Code ist %1$@. Schick allen, die bleiben, eine neue Einladung — bis dahin können ihre Handys nicht lesen, was du sendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new code is %1$@. Send a fresh invitation to everyone who stays — until you do, their phones cannot read what you send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuestro nuevo código es %1$@. Envía una invitación nueva a quienes se quedan: hasta entonces, sus teléfonos no podrán leer lo que envíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nouveau code est %1$@. Envoyez une nouvelle invitation à tous ceux qui restent — d'ici là, leurs téléphones ne peuvent pas lire ce que vous envoyez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vostro nuovo codice è %1$@. Manda un nuovo invito a chi resta: fino ad allora i loro telefoni non possono leggere ciò che invii."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasz nowy kod to %1$@. Wyślij nowe zaproszenie wszystkim, którzy zostają — do tego czasu ich telefony nie odczytają tego, co wysyłasz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O vosso novo código é %1$@. Envie um novo convite a quem fica — até lá, os telemóveis deles não conseguem ler o que enviar."
          }
        }
      }
    },
    "sync_rotated_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
