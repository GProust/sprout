    "sync_exchange_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schickt euch die Dateien in beide Richtungen, damit alle Handys aktuell sind. Dieselbe Datei zweimal zu öffnen ändert nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to each other in both directions to bring every phone up to date. Opening the same file twice changes nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaos los archivos en ambos sentidos para poner al día todos los teléfonos. Abrir el mismo archivo dos veces no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-vous les fichiers dans les deux sens pour mettre tous les téléphones à jour. Ouvrir deux fois le même fichier ne change rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviatevi i file in entrambe le direzioni per aggiornare tutti i telefoni. Aprire due volte lo stesso file non cambia nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłajcie sobie pliki w obie strony, żeby wszystkie telefony były aktualne. Otwarcie tego samego pliku dwa razy niczego nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviem os ficheiros nos dois sentidos para atualizar todos os telemóveis. Abrir o mesmo ficheiro duas vezes não muda nada."
          }
        }
      }
    },
