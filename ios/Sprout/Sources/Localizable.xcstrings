    "checkin_intro_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dir einen Moment für dich — nur ein paar kurze Fragen, eine nach der anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's take a moment for you — just a few quick questions, one at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomémonos un momento para ti: solo unas pocas preguntas rápidas, una a una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordons-nous un moment pour vous — juste quelques petites questions, une à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendiamoci un momento per te — solo qualche domanda veloce, una alla volta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poświęćmy chwilę dla Ciebie — kilka krótkich pytań, jedno po drugim."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos reservar um momento para si — apenas algumas perguntas rápidas, uma de cada vez."
          }
        }
      }
    },
