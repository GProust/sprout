<?xml version="1.0" encoding="utf-8"?>
<!--
  What crosses to a new phone on API 31 and above (ADR-0011, amended by
  ADR-0012) — the same exclusion, spelled out for both routes, because the
  defaults differ per section and an omitted section means "everything".

  `cloud-backup` is Android's backup to the parent's own Google account;
  `device-transfer` is the cable or Wi-Fi copy during new-phone setup. The
  household's sync secret is in neither in any usable form: it is wrapped by a
  Keystore key that never leaves the handset, so what lands on the new phone is
  ciphertext nothing there can open (PairingStore).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device.xml" />
    </device-transfer>
</data-extraction-rules>
