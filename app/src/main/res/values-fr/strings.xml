    <string name="growth_spurt_notif_title_baby">%1$s commence peut-être un pic de croissance</string>
    <string name="growth_spurt_notif_text">Les pics de croissance sont fréquents %1$s. Plus de repas et de grognons — c\'est normal, et ça passe en général en quelques jours.</string>

