    <string name="settings_widget_diagnostics_hint">Comprueba por qué el widget de la pantalla de inicio no funciona y comparte un informe.</string>
    <string name="widget_diagnostics_intro">Esto prueba el widget de la pantalla de inicio ahora mismo y muestra lo que ha hecho últimamente. Compártelo si el widget no funciona: no se envía nada salvo que tú lo decidas.</string>
    <string name="widget_diagnostics_share">Compartir informe</string>
    <string name="widget_diagnostics_copy">Copiar</string>
    <string name="widget_diagnostics_rerun">Ejecutar de nuevo</string>
    <string name="widget_diagnostics_force_refresh">Forzar actualización</string>
    <string name="widget_diagnostics_clear">Borrar historial</string>
    <string name="widget_error">Error del widget: consulta Ajustes → Diagnóstico del widget</string>

    <!-- Sincronización entre madres/padres (ADR-0007 fase 1) -->
    <string name="screen_sync">Compartir en el hogar</string>
    <string name="settings_sharing">Compartir</string>
    <string name="settings_sync_hint">Comparte el registro del bebé con las demás personas que lo cuidan: sin cuenta y sin nube.</string>
    <string name="sync_intro_title">Un solo registro, todos los teléfonos del hogar</string>
    <string name="sync_intro_body">Invita a la otra madre o al otro padre, o a una abuela que se queda con el bebé a menudo. Cuando un teléfono se une, cada persona puede enviar sus entradas y Sprout las combina: sin cuenta, sin servidor y sin que nada se guarde fuera de vuestros propios teléfonos.</string>
    <string name="sync_invite">Invitar a un teléfono</string>
    <string name="sync_open_invitation">Abrir una invitación recibida</string>
    <string name="sync_channel_warning">La invitación lleva la clave de vuestro registro, y quien la tenga podrá leer y añadir todo lo compartido. Envíala por un canal privado —una app de mensajería, Quick Share, Bluetooth— y nunca por un sitio público.</string>
    <string name="sync_code_title">El código de vuestro hogar</string>
    <string name="sync_code_hint">Todos los teléfonos del hogar muestran esos mismos seis caracteres. Leedlos en voz alta una vez: un teléfono que muestre otra cosa no está en vuestro hogar.</string>
    <string name="sync_send">Enviar mis entradas</string>
    <string name="sync_receive">Abrir un archivo recibido</string>
    <string name="sync_exchange_hint">Enviaos los archivos en ambos sentidos para poner al día todos los teléfonos. Abrir el mismo archivo dos veces no cambia nada.</string>
    <string name="sync_stash_title">Compartir la leche extraída</string>
    <string name="sync_stash_desc">Tu registro de extracciones y la reserva de leche, compartidos con todo el hogar o con nadie. Todo lo que tiene que ver con el bebé se comparte igualmente.</string>
    <string name="sync_stash_off_note">Desactivarlo detiene los envíos futuros. Lo que ya enviaste se queda en el otro teléfono.</string>
    <string name="sync_invite_again">Volver a enviar la invitación</string>
    <string name="sync_unpair">Salir del hogar</string>
    <string name="sync_unpair_confirm">Este teléfono dejará de enviar y de abrir los archivos del hogar. Todo lo que ya está guardado aquí se mantiene.</string>
    <string name="sync_share_invitation_subject">Invitación de Sprout</string>
    <string name="sync_share_data_subject">Entradas de Sprout</string>
    <string name="sync_paired_title">Vinculados</string>
    <string name="sync_paired_body">El código de vuestro hogar es %1$s. Comprueba que los demás teléfonos muestran el mismo.</string>
    <string name="sync_paired_body_named">Te has unido al hogar de %1$s. Vuestro código es %2$s: comprueba que los demás teléfonos muestran el mismo.</string>
    <string name="sync_merged_title">Combinado</string>
    <string name="sync_merged_nothing_new">Nada nuevo: los dos teléfonos ya coincidían.</string>
    <plurals name="sync_merged_added">
        <item quantity="one">%d entrada añadida</item>
        <item quantity="other">%d entradas añadidas</item>
    </plurals>
    <plurals name="sync_merged_updated">
        <item quantity="one">%d entrada actualizada</item>
        <item quantity="other">%d entradas actualizadas</item>
    </plurals>
    <plurals name="sync_merged_deleted">
        <item quantity="one">%d entrada eliminada</item>
        <item quantity="other">%d entradas eliminadas</item>
    </plurals>
    <string name="sync_failed_title">No se combinó nada</string>
    <string name="sync_error_not_paired">Únete antes a un hogar.</string>
    <string name="sync_error_unreadable">Este archivo no es una invitación ni una exportación de Sprout.</string>
    <string name="sync_error_wrong_phone">Este archivo no lo envió un teléfono de vuestro hogar, o se dañó por el camino.</string>
    <string name="sync_error_too_new">Este archivo se escribió con una versión más nueva de Sprout. Actualiza la aplicación e inténtalo de nuevo.</string>
    <string name="sync_error_invitation_expired">Esta invitación ha caducado. Pide una nueva.</string>
    <string name="sync_histories_title">Los dos teléfonos ya tienen entradas</string>
    <string name="sync_histories_body">Cada teléfono ha registrado por su cuenta, y Sprout no puede saber qué entradas son el mismo momento. ¿Conservarlo todo —lo anotado dos veces aparecerá duplicado— o compartir solo a partir de ahora?</string>
    <string name="sync_histories_keep_all">Conservarlo todo</string>
    <string name="sync_histories_from_pairing">A partir de ahora</string>

    <!-- Los teléfonos del hogar (ADR-0009) -->
    <string name="sync_devices_title">Teléfonos de vuestro hogar</string>
    <string name="sync_devices_empty">Ningún otro teléfono ha enviado nada todavía. Cada uno aparece aquí la primera vez que lo hace.</string>
    <string name="sync_device_unnamed">Teléfono sin nombre</string>
    <string name="sync_device_remove">Quitar</string>
    <string name="sync_remove_title">¿Quitar este teléfono?</string>
    <string name="sync_remove_body">Quitar un teléfono cambia la clave del hogar, así que todos los demás necesitarán también una invitación nueva, incluido cualquiera que esté apagado ahora mismo. El teléfono quitado conserva lo que ya tiene; eso no se le puede retirar.</string>
    <string name="sync_rotated_title">La clave del hogar ha cambiado</string>
    <string name="sync_rotated_body">Vuestro nuevo código es %1$s. Envía una invitación nueva a quienes se quedan: hasta entonces, sus teléfonos no podrán leer lo que envíes.</string>

    <!-- Intercambio automático cuando los teléfonos están cerca (ADR-0010) -->
    <string name="sync_nearby_title">Sincronizar cuando estáis juntos</string>
    <string name="sync_nearby_desc">Al abrir Sprout, buscar por Bluetooth los teléfonos del hogar que estén cerca e intercambiar con ellos. Solo busca mientras la aplicación está abierta, unos segundos cada vez.</string>
    <string name="sync_nearby_now">Buscar ahora</string>
    <string name="sync_by_hand_title">O enviar un archivo</string>
    <string name="sync_nearby_nobody_title">No hay nadie cerca</string>
    <string name="sync_nearby_nobody_body">Ningún teléfono de vuestro hogar respondió. Tiene que estar a unos metros y con Sprout abierto. Enviar un archivo funciona desde cualquier sitio.</string>
    <string name="sync_nearby_error_no_bluetooth">Este teléfono no tiene Bluetooth, así que solo puede intercambiar archivos.</string>
    <string name="sync_nearby_error_bluetooth_off">El Bluetooth está apagado. Actívalo e inténtalo de nuevo.</string>
    <string name="sync_nearby_error_no_permission">Sprout necesita permiso para detectar dispositivos cercanos. Solo se usa para reconocer los teléfonos del hogar, nunca tu ubicación.</string>
    <string name="sync_nearby_error_too_old">La versión de Android de este teléfono es demasiado antigua para esto; intercambia archivos en su lugar.</string>
    <string name="sync_nearby_error_radio">El Bluetooth se ha negado a iniciar la búsqueda. Apagarlo y volver a encenderlo suele bastar; si no, enviar un archivo siempre funciona.</string>
    <string name="sync_nearby_error_first_merge">El primer intercambio tiene una pregunta que responder. Abre una vez un archivo enviado desde el otro teléfono y después esto funcionará solo.</string>
</resources>
