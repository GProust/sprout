    <!-- Synchronizacja między rodzicami (ADR-0007 faza 1) -->
    <string name="screen_sync">Współdzielenie w domu</string>
    <string name="settings_sharing">Współdzielenie</string>
    <string name="settings_sync_hint">Udostępnij zapisy dziecka pozostałym osobom, które się nim zajmują — bez konta i bez chmury.</string>
    <string name="sync_intro_title">Jeden zapis, wszystkie telefony w domu</string>
    <string name="sync_intro_body">Zaproś drugiego rodzica albo babcię, która regularnie zajmuje się dzieckiem. Gdy telefon dołączy, każdy może wysłać swoje wpisy, a Sprout je scali: bez konta, bez serwera i bez przechowywania czegokolwiek poza waszymi własnymi telefonami.</string>
    <string name="sync_invite">Zaproś telefon</string>
    <string name="sync_open_invitation">Otwórz otrzymane zaproszenie</string>
    <string name="sync_channel_warning">Zaproszenie zawiera klucz do waszych zapisów, a każdy, kto go ma, może czytać i dopisywać wszystko, co jest współdzielone. Wyślij je czymś prywatnym — komunikatorem, Quick Share, Bluetoothem — a nigdy w miejscu publicznym.</string>
    <string name="sync_code_title">Kod waszego domu</string>
    <string name="sync_code_hint">Wszystkie telefony w domu pokazują te same sześć znaków. Przeczytajcie je sobie raz na głos: telefon, który pokazuje coś innego, nie należy do waszego domu.</string>
    <string name="sync_send">Wyślij moje wpisy</string>
    <string name="sync_receive">Otwórz otrzymany plik</string>
    <string name="sync_exchange_hint">Wysyłajcie sobie pliki w obie strony, żeby wszystkie telefony były aktualne. Otwarcie tego samego pliku dwa razy niczego nie zmienia.</string>
    <string name="sync_stash_title">Udostępniaj odciągnięte mleko</string>
    <string name="sync_stash_desc">Twój zapis odciągania i zapas mleka — udostępniane całemu domowi albo nikomu. Wszystko, co dotyczy dziecka, i tak jest współdzielone.</string>
    <string name="sync_stash_off_note">Wyłączenie zatrzymuje przyszłe wysyłki. To, co już wysłano, zostaje na drugim telefonie.</string>
    <string name="sync_invite_again">Wyślij zaproszenie ponownie</string>
    <string name="sync_unpair">Opuść dom</string>
    <string name="sync_unpair_confirm">Ten telefon przestanie wysyłać i otwierać pliki tego domu. Wszystko, co już tu zapisano, pozostaje.</string>
    <string name="sync_share_invitation_subject">Zaproszenie Sprout</string>
    <string name="sync_share_data_subject">Wpisy Sprout</string>
    <string name="sync_paired_title">Sparowano</string>
    <string name="sync_paired_body">Kod waszego domu to %1$s. Sprawdź, czy pozostałe telefony pokazują ten sam.</string>
    <string name="sync_paired_body_named">Dołączono do domu: %1$s. Wasz kod to %2$s — sprawdź, czy pozostałe telefony pokazują ten sam.</string>
    <string name="sync_merged_title">Scalono</string>
    <string name="sync_merged_nothing_new">Nic nowego — oba telefony już się zgadzały.</string>
