    <!-- Widget troubleshooting -->
    <string name="screen_widget_diagnostics">Widget-Diagnose</string>
    <string name="settings_troubleshooting">Fehlersuche</string>
    <string name="settings_widget_diagnostics_hint">Prüfen, warum das Homescreen-Widget nicht funktioniert, und einen Bericht teilen.</string>
    <string name="widget_diagnostics_intro">Dies testet das Homescreen-Widget jetzt und listet auf, was es zuletzt getan hat. Teile den Bericht, wenn das Widget nicht funktioniert – nichts wird ohne dein Zutun gesendet.</string>
    <string name="widget_diagnostics_share">Bericht teilen</string>
    <string name="widget_diagnostics_copy">Kopieren</string>
    <string name="widget_diagnostics_rerun">Erneut ausführen</string>
    <string name="widget_diagnostics_force_refresh">Aktualisierung erzwingen</string>
    <string name="widget_diagnostics_clear">Verlauf löschen</string>
    <string name="widget_error">Widget-Fehler – siehe Einstellungen → Widget-Diagnose</string>

    <!-- Partner-Synchronisierung (ADR-0007 Phase 1) -->
    <string name="screen_sync">Haushalt teilen</string>
    <string name="settings_sharing">Teilen</string>
    <string name="settings_sync_hint">Teile die Aufzeichnungen des Babys mit den anderen, die sich kümmern — ohne Konto, ohne Cloud.</string>
    <string name="sync_intro_title">Eine Aufzeichnung, alle Handys im Haushalt</string>
    <string name="sync_intro_body">Lade den anderen Elternteil ein — oder eine Großmutter, die das Baby regelmäßig hat. Sobald ein Handy dazugehört, kann jeder seine Einträge hinüberschicken und Sprout führt sie zusammen: ohne Konto, ohne Server und ohne dass irgendetwas woanders liegt als auf euren eigenen Handys.</string>
    <string name="sync_invite">Ein Handy einladen</string>
    <string name="sync_open_invitation">Erhaltene Einladung öffnen</string>
    <string name="sync_channel_warning">Die Einladung enthält den Schlüssel zu euren Aufzeichnungen, und wer ihn hat, kann alles Geteilte lesen und ergänzen. Schick sie über etwas Privates — einen Messenger, Quick Share, Bluetooth — und nicht über etwas Öffentliches.</string>
    <string name="sync_code_title">Euer Haushaltscode</string>
    <string name="sync_code_hint">Alle Handys im Haushalt zeigen dieselben sechs Zeichen. Lest sie euch einmal vor: Ein Handy, das etwas anderes zeigt, gehört nicht zu eurem Haushalt.</string>
    <string name="sync_send">Meine Einträge senden</string>
    <string name="sync_receive">Erhaltene Datei öffnen</string>
    <string name="sync_exchange_hint">Schickt euch die Dateien in beide Richtungen, damit alle Handys aktuell sind. Dieselbe Datei zweimal zu öffnen ändert nichts.</string>
    <string name="sync_stash_title">Abgepumpte Milch teilen</string>
    <string name="sync_stash_desc">Dein Abpump-Protokoll und der Milchvorrat — mit dem ganzen Haushalt geteilt oder mit niemandem. Alles rund ums Baby wird ohnehin geteilt.</string>
    <string name="sync_stash_off_note">Ausschalten stoppt künftige Sendungen. Was du bereits gesendet hast, bleibt auf dem anderen Handy.</string>
    <string name="sync_invite_again">Einladung erneut senden</string>
    <string name="sync_unpair">Haushalt verlassen</string>
    <string name="sync_unpair_confirm">Dieses Handy sendet und öffnet keine Dateien des Haushalts mehr. Alles, was hier gespeichert ist, bleibt erhalten.</string>
    <string name="sync_share_invitation_subject">Sprout-Einladung</string>
    <string name="sync_share_data_subject">Sprout-Einträge</string>
    <string name="sync_paired_title">Gekoppelt</string>
    <string name="sync_paired_body">Euer Haushaltscode ist %1$s. Prüfe, ob die anderen Handys denselben zeigen.</string>
    <string name="sync_paired_body_named">Du bist dem Haushalt von %1$s beigetreten. Euer Code ist %2$s — prüfe, ob die anderen Handys denselben zeigen.</string>
    <string name="sync_merged_title">Zusammengeführt</string>
    <string name="sync_merged_nothing_new">Nichts Neues — beide Handys waren schon einig.</string>
    <plurals name="sync_merged_added">
        <item quantity="one">%d Eintrag hinzugefügt</item>
        <item quantity="other">%d Einträge hinzugefügt</item>
    </plurals>
    <plurals name="sync_merged_updated">
        <item quantity="one">%d Eintrag aktualisiert</item>
        <item quantity="other">%d Einträge aktualisiert</item>
    </plurals>
    <plurals name="sync_merged_deleted">
        <item quantity="one">%d Eintrag entfernt</item>
        <item quantity="other">%d Einträge entfernt</item>
    </plurals>
    <string name="sync_failed_title">Nichts wurde zusammengeführt</string>
    <string name="sync_error_not_paired">Tritt zuerst einem Haushalt bei.</string>
    <string name="sync_error_unreadable">Diese Datei ist weder eine Sprout-Einladung noch ein Sprout-Export.</string>
    <string name="sync_error_wrong_phone">Diese Datei kam nicht von einem Handy aus eurem Haushalt, oder sie wurde unterwegs beschädigt.</string>
    <string name="sync_error_too_new">Diese Datei stammt aus einer neueren Version von Sprout. Aktualisiere die App und versuche es erneut.</string>
    <string name="sync_error_invitation_expired">Diese Einladung ist abgelaufen. Bitte um eine neue.</string>
    <string name="sync_histories_title">Beide Handys haben schon Einträge</string>
    <string name="sync_histories_body">Jedes Handy hat für sich aufgezeichnet, und Sprout kann nicht erkennen, welche Einträge denselben Moment meinen. Alles behalten — doppelt Notiertes erscheint dann doppelt — oder erst ab jetzt teilen?</string>
    <string name="sync_histories_keep_all">Alles behalten</string>
    <string name="sync_histories_from_pairing">Ab jetzt</string>

    <!-- Die Handys im Haushalt (ADR-0009) -->
    <string name="sync_devices_title">Handys in eurem Haushalt</string>
    <string name="sync_devices_empty">Noch hat kein anderes Handy etwas geschickt. Jedes erscheint hier, sobald es das erste Mal etwas sendet.</string>
    <string name="sync_device_unnamed">Handy ohne Namen</string>
    <string name="sync_device_remove">Entfernen</string>
    <string name="sync_remove_title">Dieses Handy entfernen?</string>
    <string name="sync_remove_body">Ein Handy zu entfernen ändert den Schlüssel des Haushalts, also braucht auch jedes andere Handy eine neue Einladung — auch eines, das gerade ausgeschaltet ist. Das entfernte Handy behält, was es schon hat; das lässt sich nicht zurücknehmen.</string>
    <string name="sync_rotated_title">Der Haushaltsschlüssel hat sich geändert</string>
    <string name="sync_rotated_body">Euer neuer Code ist %1$s. Schick allen, die bleiben, eine neue Einladung — bis dahin können ihre Handys nicht lesen, was du sendest.</string>

    <!-- Automatischer Austausch, wenn die Handys nah beieinander sind (ADR-0010) -->
    <string name="sync_nearby_title">Abgleichen, wenn ihr zusammen seid</string>
    <string name="sync_nearby_desc">Beim Öffnen von Sprout per Bluetooth nach den Handys des Haushalts in der Nähe suchen und mit ihnen austauschen. Gesucht wird nur, während die App offen ist, und jeweils ein paar Sekunden.</string>
    <string name="sync_nearby_now">Jetzt in der Nähe suchen</string>
    <string name="sync_by_hand_title">Oder eine Datei schicken</string>
    <string name="sync_nearby_nobody_title">Niemand in der Nähe</string>
    <string name="sync_nearby_nobody_body">Kein Handy aus eurem Haushalt hat geantwortet. Es muss ein paar Meter entfernt sein und Sprout offen haben. Eine Datei zu schicken geht von überall.</string>
    <string name="sync_nearby_error_no_bluetooth">Dieses Handy hat kein Bluetooth und kann daher nur Dateien austauschen.</string>
    <string name="sync_nearby_error_bluetooth_off">Bluetooth ist aus. Schalte es ein und versuche es erneut.</string>
    <string name="sync_nearby_error_no_permission">Sprout braucht die Berechtigung, Geräte in der Nähe zu finden. Sie dient nur dazu, die Handys des Haushalts zu erkennen, nie deinem Standort.</string>
    <string name="sync_nearby_error_too_old">Die Android-Version dieses Handys ist dafür zu alt; es tauscht stattdessen Dateien aus.</string>
    <string name="sync_nearby_error_radio">Bluetooth hat die Suche verweigert. Bluetooth aus- und wieder einzuschalten hilft meist; andernfalls funktioniert das Senden einer Datei immer.</string>
    <string name="sync_nearby_error_first_merge">Beim ersten Austausch ist eine Frage zu beantworten. Öffne einmal eine Datei vom anderen Handy, danach läuft es von allein.</string>
</resources>
