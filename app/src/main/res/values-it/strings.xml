    <!-- Sincronizzazione tra genitori (ADR-0007 fase 1) -->
    <string name="screen_sync">Condivisione in famiglia</string>
    <string name="settings_sharing">Condivisione</string>
    <string name="settings_sync_hint">Condividi il diario del bambino con le altre persone che se ne occupano: nessun account, nessun cloud.</string>
    <string name="sync_intro_title">Un solo diario, tutti i telefoni della famiglia</string>
    <string name="sync_intro_body">Invita l\'altro genitore, o un nonno che tiene il bambino spesso. Quando un telefono entra, ciascuno può inviare le proprie voci e Sprout le unisce: nessun account, nessun server e niente conservato al di fuori dei vostri telefoni.</string>
    <string name="sync_invite">Invita un telefono</string>
    <string name="sync_open_invitation">Apri un invito ricevuto</string>
    <string name="sync_channel_warning">L\'invito contiene la chiave del vostro diario, e chi ce l\'ha può leggere e aggiungere tutto ciò che è condiviso. Mandalo con qualcosa di privato — un\'app di messaggistica, Quick Share, Bluetooth — e mai in un luogo pubblico.</string>
    <string name="sync_code_title">Il codice della vostra famiglia</string>
    <string name="sync_code_hint">Tutti i telefoni della famiglia mostrano gli stessi sei caratteri. Leggeteveli una volta ad alta voce: un telefono che ne mostra altri non fa parte della vostra famiglia.</string>
    <string name="sync_send">Invia le mie voci</string>
    <string name="sync_receive">Apri un file ricevuto</string>
    <string name="sync_exchange_hint">Inviatevi i file in entrambe le direzioni per aggiornare tutti i telefoni. Aprire due volte lo stesso file non cambia nulla.</string>
    <string name="sync_stash_title">Condividi il latte tirato</string>
    <string name="sync_stash_desc">Il tuo registro dei tiraggi e la scorta di latte, condivisi con tutta la famiglia o con nessuno. Tutto ciò che riguarda il bambino viene condiviso comunque.</string>
    <string name="sync_stash_off_note">Disattivarlo ferma gli invii futuri. Quello che hai già inviato resta sull\'altro telefono.</string>
    <string name="sync_invite_again">Invia di nuovo l\'invito</string>
    <string name="sync_unpair">Esci dalla famiglia</string>
    <string name="sync_unpair_confirm">Questo telefono smetterà di inviare e di aprire i file della famiglia. Tutto ciò che è già salvato qui rimane.</string>
    <string name="sync_share_invitation_subject">Invito Sprout</string>
    <string name="sync_share_data_subject">Voci Sprout</string>
    <string name="sync_paired_title">Abbinati</string>
    <string name="sync_paired_body">Il codice della vostra famiglia è %1$s. Controlla che gli altri telefoni mostrino lo stesso.</string>
    <string name="sync_paired_body_named">Sei entrato nella famiglia di %1$s. Il vostro codice è %2$s: controlla che gli altri telefoni mostrino lo stesso.</string>
    <string name="sync_merged_title">Unito</string>
    <string name="sync_merged_nothing_new">Niente di nuovo: i due telefoni erano già d\'accordo.</string>
    <plurals name="sync_merged_added">
        <item quantity="one">%d voce aggiunta</item>
        <item quantity="other">%d voci aggiunte</item>
    </plurals>
    <plurals name="sync_merged_updated">
        <item quantity="one">%d voce aggiornata</item>
